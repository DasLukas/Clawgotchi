CLAW_APP_NAME=Clawgotchi
CLAW_HOST=0.0.0.0
CLAW_PORT=8000
CLAW_LOG_LEVEL=INFO
CLAW_TICK_INTERVAL_SECONDS=2
CLAW_RUNTIME_HOME=
CLAW_DATABASE_URL=sqlite:////absolute/path/to/clawgotchi.db
CLAW_PLUGIN_DIRECTORY=/absolute/path/to/runtime/plugins
CLAW_THEME_DIRECTORY=/absolute/path/to/runtime/themes
CLAW_PLUGIN_DIRECTORIES=/absolute/path/to/runtime/plugins,/absolute/path/to/repo/plugins
CLAW_THEME_DIRECTORIES=/absolute/path/to/runtime/themes,/absolute/path/to/repo/themes
CLAW_CONFIG_FILE=/absolute/path/to/repo/config/defaults.toml
CLAW_API_KEY=
CLAW_DISPLAY_TYPE=dummy
CLAW_DISPLAY_ROTATION=0
CLAW_DISPLAY_USE_PARTIAL=false
CLAW_DISPLAY_DITHERING=false
CLAW_DISPLAY_DEBUG_WRITE_PNG=true
CLAW_DISPLAY_DEBUG_PNG_PATH=/tmp/clawgotchi_last_frame.png
