CLAW_APP_NAME=Clawgotchi
CLAW_HOST=0.0.0.0
CLAW_PORT=8000
CLAW_LOG_LEVEL=INFO
CLAW_TICK_INTERVAL_SECONDS=2
CLAW_DATABASE_URL=sqlite:///./clawgotchi.db
CLAW_PLUGIN_DIRECTORY=./plugins
CLAW_THEME_DIRECTORY=./themes
CLAW_CONFIG_FILE=./config/defaults.toml
CLAW_API_KEY=
CLAW_DISPLAY_TYPE=dummy
CLAW_DISPLAY_VENDOR=waveshare
CLAW_DISPLAY_ROTATION=0
CLAW_DISPLAY_USE_PARTIAL=false
CLAW_DISPLAY_DITHERING=false
CLAW_DISPLAY_DEBUG_WRITE_PNG=true
CLAW_DISPLAY_DEBUG_PNG_PATH=/tmp/clawgotchi_last_frame.png
CLAW_DISPLAY_SPI_BUS=0
CLAW_DISPLAY_SPI_DEVICE=0
CLAW_DISPLAY_SPI_MAX_HZ=2000000
CLAW_DISPLAY_GPIO_DC_PIN=25
CLAW_DISPLAY_GPIO_RST_PIN=17
CLAW_DISPLAY_GPIO_BUSY_PIN=24
CLAW_DISPLAY_GPIO_CS_PIN=8
