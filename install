#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]:-${0:-bash}}"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_SOURCE}")" && pwd)"
LOCAL_BOOTSTRAP="${SCRIPT_DIR}/scripts/install_bootstrap.sh"
LOCAL_COMMON_INSTALL="${SCRIPT_DIR}/scripts/common_install.py"
BOOTSTRAP_URL="${CLAW_INSTALL_BOOTSTRAP_URL:-https://raw.githubusercontent.com/DasLukas/Clawgotchi/main/scripts/install_bootstrap.sh}"

if [[ -f "${LOCAL_BOOTSTRAP}" ]]; then
  exec bash "${LOCAL_BOOTSTRAP}" "$@"
fi

if [[ -f "${LOCAL_COMMON_INSTALL}" ]]; then
  exec python3 "${LOCAL_COMMON_INSTALL}" --repo-root "${SCRIPT_DIR}" "$@"
fi

curl -fsSL "${BOOTSTRAP_URL}" | bash -s -- "$@"
