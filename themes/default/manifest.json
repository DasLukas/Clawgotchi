{
  "id": "default",
  "name": "Default ePaper Theme",
  "version": "0.2.0",
  "description": "Default sprite-based pet theme for monochrome displays.",
  "preview": "Sprite animation set with sidebar-aware placement.",
  "stylesheet": "assets/style.css",
  "render": {
    "base_sprite_size": [160, 128],
    "dither": false,
    "threshold": 128
  },
  "placement": {
    "mode": "sprite",
    "anchor": "bottom_center",
    "offset_x": 0,
    "offset_y": -2,
    "scale_mode": "integer_only",
    "scale": 1.0
  },
  "canvas_width": 264,
  "canvas_height": 176,
  "default_animation": "idle",
  "animations": {
    "idle": {
      "fps": 0.33,
      "frames": [
        "../classic/assets/idle_0.png",
        "../classic/assets/idle_1.png",
        "../classic/assets/idle_2.png"
      ]
    },
    "scratch": {
      "fps": 2.0,
      "duration_ms": 1200,
      "frames": [
        "../classic/assets/scratch_0.png",
        "../classic/assets/scratch_1.png"
      ]
    }
  }
}
